# ─── Зависимости и сборки ────────────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
.vite/
.cache/

# ─── Секреты ─────────────────────────────────────────────────────────────────
# .env содержит пароль базы, JWT-секрет и ключ API — в репозиторий не попадает
# никогда. Шаблон .env.example лежит рядом и коммитится.
.env
.env.local
.env.*.local
# Настройки экземпляров клиентов (.env.larus и т.п.) — там пароль базы и
# секрет сессий каждого клиента. Правило шире прежнего намеренно: файл
# .env.<клиент> под прежние шаблоны не попадал и уехал бы в репозиторий.
.env.*
!.env.example

# Приватные ключи TLS локального стенда
infra/tls/*.key
infra/tls/*.crt
infra/tls/*.pem

# ─── Данные ──────────────────────────────────────────────────────────────────
pgdata/
uploads/
*.log
npm-debug.log*
coverage/

# ─── Системное и редакторы ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# ─── Windows/WSL ─────────────────────────────────────────────────────────────
*:Zone.Identifier

# Артефакты tsc рядом с исходниками. Появлялись из-за `tsc -b --noEmit false`
# в сборке приложения: компилятор без outDir раскладывал .js возле каждого
# .ts/.tsx, и 50+ таких файлов едва не уехали в коммит. Там они опаснее мусора —
# сборка подхватывает их вместо исходников, и правка перестаёт действовать.
# Причина починена, это страховка.
apps/*/src/**/*.js
packages/*/src/**/*.js
*.tsbuildinfo
