# ─── Домен / сеть ────────────────────────────────────────────────────────────
PUBLIC_HOST=local.westauto.com.ua
HTTP_PORT=8081

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=avtoklyuch
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=avtoklyuch
DATABASE_URL=postgres://avtoklyuch:change_me_in_production@db:5432/avtoklyuch

# ─── API ─────────────────────────────────────────────────────────────────────
API_PORT=3000
NODE_ENV=development
# Секрет для подписи JWT. В проде обязательно заменить: openssl rand -hex 48
JWT_SECRET=dev_only_insecure_secret_replace_me_with_openssl_rand_hex_48
# Срок жизни сессии
SESSION_TTL_HOURS=12

# ─── Первый администратор (создаётся при первом старте, если БД пустая) ──────
BOOTSTRAP_ADMIN_LOGIN=admin
BOOTSTRAP_ADMIN_PASSWORD=admin12345
BOOTSTRAP_ADMIN_NAME=Администратор

# ─── baza-gai.com.ua (растаможка) ────────────────────────────────────────────
# Бесплатный ключ (1000 запросов/мес) — форма на https://baza-gai.com.ua/
# Пока пусто — калькулятор считает растаможку локальной оценочной формулой
# и явно помечает результат как «оценка».
BAZA_GAI_API_KEY=
BAZA_GAI_BASE_URL=https://baza-gai.com.ua
BAZA_GAI_TIMEOUT_MS=8000

# ─── Курсы валют (НБУ, публичный API, ключ не нужен) ─────────────────────────
NBU_RATES_URL=https://bank.gov.ua/NBUStatService/v1/statdirectory/exchange?json
FX_REFRESH_MINUTES=180

# ─── Парсер лотов Copart / IAAI ──────────────────────────────────────────────
# Модуль отключаемый: off — кнопка «Подтянуть данные» сразу предлагает ручной ввод
LOT_FETCHER_ENABLED=true
LOT_FETCHER_TIMEOUT_MS=12000
HTTPS_PORT=8443
