# ─── Сборка сайта и приложения ───────────────────────────────────────────────
FROM node:20-bookworm-slim AS build

WORKDIR /srv

COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/api/package.json apps/api/
COPY apps/app/package.json apps/app/
COPY apps/site-autokey/package.json apps/site-autokey/
COPY apps/site-westauto/package.json apps/site-westauto/

RUN npm ci

COPY . .

RUN npm run build -w @avtoklyuch/shared \
 && npm run build -w @avtoklyuch/site-autokey \
 && npm run build -w @avtoklyuch/site-westauto \
 && npm run build -w @avtoklyuch/app

# ─── Сервер сайта: отрисовка страниц витрины ─────────────────────────────────
#
# Карточки авто меняются каждый день, поэтому пререндера при сборке мало —
# страницы собираются на запрос, чтобы поисковик видел готовую разметку.
FROM node:20-bookworm-slim AS site

WORKDIR /srv
ENV NODE_ENV=production

COPY --from=build /srv/apps/site-autokey/dist apps/site-autokey/dist
COPY --from=build /srv/apps/site-autokey/dist-ssr apps/site-autokey/dist-ssr

USER node
EXPOSE 4173

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:4173/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "apps/site-autokey/dist-ssr/server.js"]

# ─── Сервер сайта WestAuto ───────────────────────────────────────────────────
#
# Тот же приём, что у АвтоКлюча: страницы собираются на запрос. Сюда же
# приходят сайты агентов — они отличаются только именем поддомена в запросе.
FROM node:20-bookworm-slim AS site-westauto

WORKDIR /srv
ENV NODE_ENV=production

COPY --from=build /srv/apps/site-westauto/dist apps/site-westauto/dist
COPY --from=build /srv/apps/site-westauto/dist-ssr apps/site-westauto/dist-ssr

USER node
EXPOSE 4174

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:4174/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "apps/site-westauto/dist-ssr/server.js"]

# ─── Раздача: nginx перед сервером сайта ─────────────────────────────────────
FROM nginx:1.27-alpine AS runtime

COPY infra/nginx/prod.conf /etc/nginx/conf.d/default.conf
# Внутреннее приложение — статика, поисковикам оно не нужно
COPY --from=build /srv/apps/app/dist /usr/share/nginx/html/app

EXPOSE 80
